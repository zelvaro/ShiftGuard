# --- API ---
ENVIRONMENT=dev
# Port Postgres exposé sur le PC par docker compose (doit correspondre à DATABASE_URL)
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://shiftguard:shiftguard@127.0.0.1:5432/shiftguard
# 127.0.0.1 plutôt que localhost : sous Windows, localhost passe par IPv6 et peut bloquer
REDIS_URL=redis://127.0.0.1:6379/0
# Secret de signature des JWT. En prod : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=dev-only-change-me-dev-only-change-me
ACCESS_TOKEN_EXPIRE_MINUTES=720

# --- WhatsApp Cloud API (Meta for Developers) ---
WHATSAPP_VERIFY_TOKEN=change-me
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v23.0

# --- IA ---
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=
STT_MODEL=whisper-large-v3

# --- Stockage documents (SeaweedFS en local, S3 en prod) ---
S3_ENDPOINT=http://localhost:8333
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=agent-documents

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
