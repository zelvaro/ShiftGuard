# --- API ---
ENVIRONMENT=dev
DATABASE_URL=postgresql+psycopg://shiftguard:shiftguard@localhost:5432/shiftguard
REDIS_URL=redis://localhost:6379/0

# --- WhatsApp Cloud API (Meta for Developers) ---
